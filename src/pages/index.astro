<script is:inline>
// Theme toggle
const toggle = document.getElementById('themeToggle');
const icon = document.getElementById('themeIcon');
const label = document.getElementById('themeLabel');
function updateThemeUI(){
  const dark = document.documentElement.getAttribute('data-theme')==='dark';
  icon.textContent = dark ? '☀️' : '🌙';
  label.textContent = dark ? '라이트 모드' : '다크 모드';
}
updateThemeUI();
toggle.addEventListener('click',()=>{
  const isDark = document.documentElement.getAttribute('data-theme')==='dark';
  const next = isDark ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  try { localStorage.setItem('theme', next); } catch(e){}
  updateThemeUI();
});

// Mobile sidebar
const mobileToggle = document.getElementById('mobileToggle');
const sidebar = document.getElementById('sidebar');
const overlay = document.getElementById('mobileOverlay');
function closeSidebar(){ sidebar.classList.remove('open'); overlay.classList.remove('show'); }
mobileToggle.addEventListener('click',()=>{
  sidebar.classList.toggle('open');
  overlay.classList.toggle('show');
});
overlay.addEventListener('click', closeSidebar);
sidebar.querySelectorAll('a').forEach(a => a.addEventListener('click', closeSidebar));

// Nav pills
function switchTab(tabId){
  document.querySelectorAll('.nav-pill').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  const pill = document.querySelector(`.nav-pill[data-tab="${tabId}"]`);
  if(pill) pill.classList.add('active');
  const tab = document.getElementById(tabId);
  if(tab) tab.classList.add('active');
}
document.querySelectorAll('.nav-pill').forEach(pill=>{
  pill.addEventListener('click',()=> switchTab(pill.dataset.tab));
});

// Sidebar nav: auto-switch tab before scrolling
sidebar.querySelectorAll('a[href^="#"]').forEach(link => {
  link.addEventListener('click', (e) => {
    const targetId = link.getAttribute('href').substring(1);
    const targetEl = document.getElementById(targetId);
    if(!targetEl) return;
    e.preventDefault();
    // Find which tab contains the target
    const parentTab = targetEl.closest('.tab-content');
    if(parentTab){
      switchTab(parentTab.id);
    }
    // If target is a file-card, ensure its phase is open and the card body is expanded
    if(targetEl.classList.contains('file-card')){
      const phaseContent = targetEl.closest('.phase-content');
      if(phaseContent && phaseContent.style.display==='none'){
        phaseContent.style.display='block';
        const banner = phaseContent.previousElementSibling;
        if(banner) banner.querySelector('.toggle-arrow')?.classList.add('open');
      }
      const body = targetEl.querySelector('.fc-body');
      const arrow = targetEl.querySelector('.fc-toggle');
      if(body && !body.classList.contains('open')){
        body.classList.add('open');
        if(arrow) arrow.classList.add('open');
        body.querySelectorAll('code:not(.highlighted)').forEach(block => {
          if(typeof Prism !== 'undefined') Prism.highlightElement(block);
          block.classList.add('highlighted');
        });
      }
    }
    closeSidebar();
    setTimeout(()=> targetEl.scrollIntoView({behavior:'smooth', block:'start'}), 50);
  });
});

// Phase toggle
document.querySelectorAll('.phase-banner').forEach(banner => {
  banner.addEventListener('click', () => {
    const id = 'phase-' + banner.dataset.phase;
    const content = document.getElementById(id);
    const arrow = banner.querySelector('.toggle-arrow');
    if(content.style.display==='none'){
      content.style.display='block';
      arrow.classList.add('open');
    } else {
      content.style.display='none';
      arrow.classList.remove('open');
    }
  });
});

// File card toggle
document.querySelectorAll('.fc-header').forEach(header => {
  header.addEventListener('click', () => {
    const body = header.nextElementSibling;
    const arrow = header.querySelector('.fc-toggle');
    body.classList.toggle('open');
    arrow.classList.toggle('open');
    if(body.classList.contains('open')){
      body.querySelectorAll('code:not(.highlighted)').forEach(block => {
        if(typeof Prism !== 'undefined') Prism.highlightElement(block);
        block.classList.add('highlighted');
      });
    }
  });
});

// Full script toggle
document.querySelectorAll('.full-script-toggle').forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const targetId = btn.dataset.script;
    const target = document.getElementById(targetId);
    const isOpen = target.classList.contains('open');
    target.classList.toggle('open');
    btn.textContent = isOpen ? '📄 전체 스크립트 보기' : '📄 전체 스크립트 닫기';
    if(!isOpen){
      target.querySelectorAll('code:not(.highlighted)').forEach(block => {
        if(typeof Prism !== 'undefined') Prism.highlightElement(block);
        block.classList.add('highlighted');
      });
    }
  });
});
</script>

</Layout>
