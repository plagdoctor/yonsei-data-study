import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';

// Read all Python files at build time
const scriptsDir = path.join(process.cwd(), 'src/data/scripts');
function readPy(name: string): string {
  try { return fs.readFileSync(path.join(scriptsDir, name), 'utf-8'); }
  catch { return '# 파일을 찾을 수 없습니다.'; }
}

