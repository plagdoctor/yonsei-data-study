       code:`df['Risk_Score'] = (df['Risk_Weather'] + df['Risk_Road']\n                  + df['Risk_Density'] + df['Risk_Speed'])`,
       result:'0점(5.1%) → 4점(82.8%) — 16배 상승',
       concepts:[{term:'복합 위험 점수',desc:'4가지 위험 요인 개수를 0~4점으로 표현'}],
       fullCode: readPy('21_viz7_risk_score.py')}
    ]},
  { id:'report', label:'Phase 6: 종합 EDA 보고서', cls:'pb-report', dot:'#764ba2',
    sub:'모든 분석을 17페이지 PDF로 통합',
    files:[
      {num:'22', title:'Full EDA Part 1 — 데이터 개요+분포 (Pages 1-5)', file:'22_full_eda_part1.py', color:'#2d1b69',
       what:'PDF를 열고 데이터셋 개요, 수치형·범주형 분포, 심층 분석까지 5페이지를 생성합니다.',
       analogy:'보고서 1~5장: "데이터는 이렇게 생겼습니다"',
       code:`from matplotlib.backends.backend_pdf import PdfPages\npdf = PdfPages(pdf_path)\nfig = plt.figure(figsize=(16, 10))\npdf.savefig(fig); plt.close()`,
       result:'Pages 1-5 생성',concepts:[],
       fullCode: readPy('22_full_eda_part1.py')},
      {num:'23', title:'Full EDA Part 2 — 상관관계+상호작용 (Pages 6-10)', file:'23_full_eda_part2.py', color:'#2d1b69',
       what:'피어슨 히트맵, 다중공선성, 카이제곱, 상호작용, 밀도 증폭까지 5페이지를 추가합니다.',
       analogy:'보고서 6~10장: "변수들의 관계"',
       code:`fig, axes = plt.subplots(1, 2, figsize=(16, 7))\nsns.heatmap(corr_matrix, annot=True, ax=axes[0])\npdf.savefig(fig); plt.close()`,
       result:'Pages 6-10 추가 완료',concepts:[],
       fullCode: readPy('23_full_eda_part2.py')},
      {num:'24', title:'Full EDA Part 3 — 심층분석+요약 (Pages 11-17)', file:'24_full_eda_part3.py', color:'#2d1b69',
       what:'차량유형, 복합 위험 점수, Top 10 고위험 조합, 운전자 분석, 도로유형×시간대, 조명, 종합 요약까지 7페이지 추가 + pdf.close()로 완성.',
       analogy:'보고서 11~17장: "심층 분석과 최종 결론"',
       code:`# Page 11~17: 심층 분석\npdf.close()  # PDF 완성!`,
       result:'traffic_accident_full_EDA_report.pdf (17페이지) 최종 완성',concepts:[],
       fullCode: readPy('24_full_eda_part3.py')}
    ]}
];
---

<Layout title="교통사고 데이터 분석 — 종합 스터디 가이드">

<!-- Theme Toggle -->
<button class="theme-toggle" id="themeToggle">
  <span class="icon" id="themeIcon">🌙</span>
  <span id="themeLabel">다크 모드</span>
</button>

<!-- Mobile Toggle -->
<button class="mobile-toggle" id="mobileToggle">☰</button>
<div class="mobile-overlay" id="mobileOverlay"></div>

<!-- Sidebar -->
<nav class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <h2><span class="logo-icon">📊</span>분석 스터디 가이드</h2>
    <div class="logo-sub">교통사고 데이터 · 24개 Python 파일</div>
  </div>

  <a href="#overview" style="color:rgba(255,255,255,.7);font-weight:600;padding:8px 22px;font-size:12.5px;margin-top:4px;display:block">전체 개요</a>

  {phases.map(p => (
    <div class="nav-group">
      <div class="phase-chip">
        <span class="phase-dot" style={`background:${p.dot}`}></span>
        <span style="font-weight:600">{p.label.split(':')[0]}</span>
      </div>
      {p.files.map(f => (
        <a href={`#file-${f.num}`}><span class="fnum">{f.num}</span>{f.title.length > 22 ? f.title.substring(0,22)+'…' : f.title}</a>
      ))}
    </div>
  ))}

  <div class="nav-divider"></div>
  <div class="nav-bottom">
    <a href="#insights">핵심 시사점 (7개)</a>
    <a href="#actions">활용방안 (5개)</a>
    <a href="#glossary">용어 사전</a>
  </div>
</nav>

<!-- Main Content -->
<div class="main">

<!-- Hero -->
<div class="hero" id="overview">
  <h1>교통사고 데이터 분석 종합 스터디 가이드</h1>
  <div class="sub">24개 Python 코드의 역할 · 전처리부터 시사점 도출까지 · 통계 초보자를 위한 해설</div>
  <div class="badges">
    <span class="badge">📁 24개 Python 파일</span>
    <span class="badge">🔄 6단계 파이프라인</span>
    <span class="badge">☁️ Google Colab</span>
    <span class="badge">📊 840건 교통사고</span>
    <span class="badge">📄 17p PDF 보고서</span>
  </div>
</div>

<!-- Nav Pills -->
<div class="nav-pills" id="navPills">
  <div class="nav-pill active" data-tab="code-tab">코드 스터디</div>
  <div class="nav-pill" data-tab="insight-tab">분석 결과 & 시사점</div>
</div>

<!-- ═══════ TAB 1: CODE STUDY ═══════ -->
<div class="tab-content active" id="code-tab">

<!-- Pipeline Flow -->
<div class="section">
  <h3 style="margin-bottom:10px;">전체 분석 파이프라인</h3>
  <div class="flow-row">
    {phases.map((p,i) => (
      <Fragment>
        {i > 0 && <span class="flow-arrow">→</span>}
        <div class="flow-step">{p.label.split(':')[0]}<br/><small style="color:var(--text3)">{p.files.length}개 파일</small></div>
      </Fragment>
    ))}
  </div>
  <p style="font-size:11.5px;color:var(--text3);margin-top:8px;">각 파일은 Google Colab에서 하나의 코드 셀로 순서대로 실행합니다. 앞 셀의 변수(df 등)가 뒤 셀에서 그대로 이어집니다.</p>
</div>

<!-- Phases & Files -->
{phases.map(phase => (
  <div>
    <div class={`phase-banner ${phase.cls}`} data-phase={phase.id}>
      <div>
        <div>{phase.label}</div>
        <div class="phase-sub">{phase.sub}</div>
      </div>
      <span class="toggle-arrow">▼</span>
    </div>
    <div class="phase-content" id={`phase-${phase.id}`} style="display:block;">
      {phase.files.map(f => (
        <div class="file-card" id={`file-${f.num}`}>
          <div class="fc-header">
            <div class="fc-num" style={`background:${f.color}`}>{f.num}</div>
            <div class="fc-info">
              <h3>{f.title}</h3>
              <div class="fc-file">{f.file}</div>
            </div>
            <div class="fc-toggle">▼</div>
          </div>
          <div class="fc-body">
            <div class="explain-box">
              <h4>이 파일은 무엇을 하나요?</h4>
              <p>{f.what}</p>
            </div>
            {f.analogy && (
              <div class="analogy">
                <div class="a-title">비유하자면...</div>
                <p>{f.analogy}</p>
              </div>
            )}
            <div class="code-block">
              <span class="code-label">핵심 코드</span>
              <pre><code class="language-python">{f.code}</code></pre>
            </div>
            <div class="explain-box success">
              <h4>실행 결과</h4>
              <p>{f.result}</p>
            </div>
            {f.concepts && f.concepts.length > 0 && (
              <div class="explain-box purple">
                <h4>핵심 개념</h4>
                {f.concepts.map(c => (
                  <p><strong>{c.term}</strong>: {c.desc}</p>
                ))}
              </div>
            )}
            <button class="full-script-toggle" data-script={`script-${f.num}`}>
              📄 전체 스크립트 보기 ({f.file})
            </button>
            <div class="full-script-box" id={`script-${f.num}`}>
              <div class="code-block">
                <span class="code-label">{f.file} — 전체 코드</span>
                <pre><code class="language-python">{f.fullCode}</code></pre>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
))}
</div>

<!-- ═══════ TAB 2: INSIGHTS ═══════ -->
<div class="tab-content" id="insight-tab">

<div class="section" id="insights">
  <span class="section-num">시사점 1</span>
  <h2>사고 심각도를 결정짓는 핵심 변수는 "환경 조건"이다</h2>
  <p style="font-size:12.5px;color:var(--text2);margin-bottom:14px;">변수-타겟 연관 강도 순위 (Pearson |r| 또는 Cramer's V)</p>
  <div class="risk-bar-wrap"><div class="risk-bar-label"><span>1위 — Road_Condition (노면 상태)</span><span style="color:var(--danger);font-weight:700">V = 0.5703</span></div><div class="risk-bar-bg"><div class="risk-bar-fill" style="width:95%;background:linear-gradient(90deg,#e94560,#c0392b)"><span>0.5703</span></div></div></div>
  <div class="risk-bar-wrap"><div class="risk-bar-label"><span>2위 — Weather (기상 조건)</span><span style="color:var(--warning);font-weight:700">V = 0.5498</span></div><div class="risk-bar-bg"><div class="risk-bar-fill" style="width:91%;background:linear-gradient(90deg,#e67e22,#d35400)"><span>0.5498</span></div></div></div>
  <div class="risk-bar-wrap"><div class="risk-bar-label"><span>3위 — Traffic_Density (교통 밀도)</span><span style="color:var(--warning);font-weight:700">|r| = 0.4433</span></div><div class="risk-bar-bg"><div class="risk-bar-fill" style="width:74%;background:linear-gradient(90deg,#f39c12,#e67e22)"><span>0.4433</span></div></div></div>
  <div class="risk-bar-wrap"><div class="risk-bar-label"><span>4위 — Speed_Limit (제한 속도)</span><span style="color:var(--info);font-weight:700">|r| = 0.2508</span></div><div class="risk-bar-bg"><div class="risk-bar-fill" style="width:42%;background:linear-gradient(90deg,#3498db,#2980b9)"><span>0.2508</span></div></div></div>
  <div class="risk-bar-wrap"><div class="risk-bar-label"><span>5~10위 — Road_Type, Vehicle_Type, Light, Time, Age, Exp</span><span style="color:var(--text3);font-weight:700">0.02~0.07</span></div><div class="risk-bar-bg"><div class="risk-bar-fill" style="width:11%;background:#bbb"><span>&lt;0.07</span></div></div></div>
  <div class="insight-card" style="margin-top:14px"><div class="insight-title">핵심 시사점</div><p>사고 심각도의 대부분은 <strong>운전자 특성(연령·경력)</strong>이 아니라 <strong>환경 조건(노면·기상·교통밀도)</strong>에 의해 결정됩니다. 상위 3개 변수의 연관 강도(0.44~0.57)가 나머지 7개(0.02~0.07)보다 <strong>6~28배 높습니다.</strong></p></div>
</div>

<div class="section">
  <span class="section-num">시사점 2</span>
  <h2>특정 환경 조건에서 심각 사고율이 극단적으로 상승한다</h2>
  <p style="font-size:12.5px;color:var(--text2);margin-bottom:12px;">개별 위험 요인 노출 시 심각 사고율 변화</p>
  <div class="card-grid" style="grid-template-columns:repeat(4,1fr)">
    <div class="card"><div class="card-value" style="color:var(--danger)">+57.2%p</div><div class="card-label">교통밀도 High</div><div class="card-sub">13.5% → 70.8%</div></div>
    <div class="card"><div class="card-value" style="color:var(--warning)">+47.4%p</div><div class="card-label">악천후</div><div class="card-sub">10.4% → 57.8%</div></div>
    <div class="card"><div class="card-value" style="color:#d4a017">+47.2%p</div><div class="card-label">노면 불량</div><div class="card-sub">8.8% → 56.0%</div></div>
    <div class="card"><div class="card-value" style="color:var(--info)">+18.4%p</div><div class="card-label">고속 (&gt;80)</div><div class="card-sub">26.3% → 44.8%</div></div>
  </div>
  <div class="insight-card orange"><div class="insight-title">핵심 시사점</div><p><strong>교통밀도 High</strong>에서 심각 사고율 70.8%로 가장 큰 단독 위험 요인. 단 하나의 환경 요인만 불리해져도 <strong>사고율이 5~7배 급등</strong>합니다.</p></div>
</div>

<div class="section">
  <span class="section-num">시사점 3</span>
  <h2>위험 요인은 "누적"될수록 기하급수적으로 위험해진다</h2>
  <p style="font-size:12.5px;color:var(--text2);margin-bottom:12px;">복합 위험 점수(0~4) = 악천후 + 노면불량 + 고밀도 + 고속</p>
  <div class="tbl-wrap"><table>
    <tr><th>위험 점수</th><th>해석</th><th>건수</th><th>비중</th><th>심각 사고율</th><th>위험도</th></tr>
    <tr><td><strong>0</strong></td><td>안전</td><td>430건</td><td>51.2%</td><td><span class="badge-s">5.1%</span></td><td style="color:var(--success)">●○○○○</td></tr>
    <tr><td><strong>1</strong></td><td>요인 1개</td><td>73건</td><td>8.7%</td><td><span class="badge-w">34.2%</span></td><td style="color:var(--warning)">●●○○○</td></tr>
    <tr><td><strong>2</strong></td><td>요인 2개</td><td>128건</td><td>15.2%</td><td><span class="badge-w">35.9%</span></td><td style="color:var(--warning)">●●●○○</td></tr>
    <tr><td><strong>3</strong></td><td>요인 3개</td><td>180건</td><td>21.4%</td><td><span class="badge-d">67.8%</span></td><td style="color:var(--danger)">●●●●○</td></tr>
    <tr><td><strong>4</strong></td><td>모든 요인</td><td>29건</td><td>3.5%</td><td><span class="badge-d">82.8%</span></td><td style="color:#c0392b">●●●●●</td></tr>
  </table></div>
  <div class="stat-grid" style="margin-top:12px">
    <div class="stat-card" style="border-color:var(--danger)"><div class="sv" style="color:var(--danger)">16배</div><div class="sl">0점→4점 상승폭</div></div>
    <div class="stat-card" style="border-color:var(--warning)"><div class="sv" style="color:var(--warning)">57.0%</div><div class="sl">2개 이상 심각율</div></div>
    <div class="stat-card" style="border-color:var(--info)"><div class="sv" style="color:var(--info)">2→3점</div><div class="sl">가장 급격한 점프</div><div class="ss">35.9%→67.8%</div></div>
  </div>
  <div class="insight-card"><div class="insight-title">0점 → 4점 = 16배 상승</div><p>위험 0개=5.1%에서 4개=<strong>82.8%</strong>로 약 16배 급등. 특히 2점→3점 구간에서 <strong>가장 급격한 점프</strong>.</p></div>
  <div class="insight-card orange"><div class="insight-title">임계점: 위험 요인 2개 이상</div><p>2개 이상(337건, 40.1%)이면 심각율 <strong>57.0%</strong>. <strong>2개 이상부터 과반이 심각</strong>하므로 경보 발령의 실질적 임계점.</p></div>
</div>

<div class="section">
  <span class="section-num">시사점 4</span>
  <h2>교통밀도(Traffic Density)는 "증폭기" 역할</h2>
  <div class="stat-grid" style="grid-template-columns:repeat(3,1fr)">
    <div class="stat-card" style="border-color:var(--success)"><div class="sv" style="color:var(--success)">15.5%</div><div class="sl">Low</div></div>
    <div class="stat-card" style="border-color:var(--warning)"><div class="sv" style="color:var(--warning)">12.6%</div><div class="sl">Medium</div></div>
    <div class="stat-card" style="border-color:var(--danger)"><div class="sv" style="color:var(--danger)">70.8%</div><div class="sl">High</div></div>
  </div>
  <div class="insight-card blue"><div class="insight-title">비선형 점프: 4.6배 급등</div><p>Low(15.5%)와 Medium(12.6%)은 유사하지만, <strong>High에서 70.8%</strong>로 비선형 점프. Rainy + Wet + High Density = <strong>89.1%</strong>.</p></div>
</div>

<div class="section">
  <span class="section-num">시사점 5</span>
  <h2>최고 위험 조합 vs 최저 위험 조합 = 약 19배 차이</h2>
  <h4 style="color:var(--danger);font-size:13px;margin-bottom:6px">위험 조합 TOP 5</h4>
  <div class="tbl-wrap"><table>
    <tr><th>#</th><th>기상</th><th>노면</th><th>밀도</th><th>건수</th><th>심각</th><th>심각율</th></tr>
    <tr><td>1</td><td>Rainy</td><td>Wet</td><td>High</td><td>138</td><td>123</td><td><span class="badge-d">89.1%</span></td></tr>
    <tr><td>2</td><td>Stormy</td><td>Wet</td><td>Low</td><td>6</td><td>4</td><td><span class="badge-d">66.7%</span></td></tr>
    <tr><td>3</td><td>Snowy</td><td>Icy</td><td>Medium</td><td>9</td><td>5</td><td><span class="badge-d">55.6%</span></td></tr>
    <tr><td>4</td><td>Clear</td><td>Wet</td><td>High</td><td>12</td><td>6</td><td><span class="badge-w">50.0%</span></td></tr>
    <tr><td>5</td><td>Clear</td><td>Dry</td><td>High</td><td>31</td><td>13</td><td><span class="badge-w">41.9%</span></td></tr>
  </table></div>
  <h4 style="color:var(--success);font-size:13px;margin:12px 0 6px">안전 조합 TOP 5</h4>
  <div class="tbl-wrap"><table>
    <tr><th>#</th><th>기상</th><th>노면</th><th>밀도</th><th>건수</th><th>심각</th><th>심각율</th></tr>
    <tr><td>1</td><td>Rainy</td><td>Under Constr.</td><td>Low</td><td>6</td><td>0</td><td><span class="badge-s">0.0%</span></td></tr>
    <tr><td>2</td><td>Clear</td><td>Dry</td><td>Medium</td><td>316</td><td>15</td><td><span class="badge-s">4.7%</span></td></tr>
    <tr><td>3</td><td>Clear</td><td>Dry</td><td>Low</td><td>127</td><td>11</td><td><span class="badge-s">8.7%</span></td></tr>
    <tr><td>4</td><td>Foggy</td><td>Dry</td><td>Low</td><td>7</td><td>1</td><td><span class="badge-s">14.3%</span></td></tr>
    <tr><td>5</td><td>Clear</td><td>Wet</td><td>Low</td><td>11</td><td>2</td><td><span class="badge-s">18.2%</span></td></tr>
  </table></div>
  <div class="insight-card green"><div class="insight-title">핵심 시사점</div><p>"Rainy+Wet+High" = <strong>89.1%</strong>(10건 중 9건 심각) vs "Clear+Dry+Medium" = <strong>4.7%</strong>. 환경 조건만으로 <strong>약 19배</strong> 차이.</p></div>
</div>

<div class="section">
  <span class="section-num">시사점 6</span>
  <h2>운전자 연령과 경력은 사실상 같은 변수 (r = 0.9453)</h2>
  <div class="card-grid" style="grid-template-columns:1fr 1fr">
    <div class="card" style="border-color:var(--accent2)"><div class="card-value" style="color:var(--accent2)">0.9453</div><div class="card-label">Pearson r</div><div class="card-sub">Driver_Age × Driver_Experience</div></div>
